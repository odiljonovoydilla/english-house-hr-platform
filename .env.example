# Bu faylni ko'chirib, nomini ".env" ga o'zgartiring va haqiqiy qiymatlarni kiriting.
# Railway'da esa bu qiymatlarni "Variables" bo'limiga alohida-alohida kiritasiz.

# ---- Majburiy ----
PUBLIC_URL=https://your-app-name.up.railway.app
SESSION_SECRET=biror-tasodifiy-uzun-soz-2026
DB_PATH=/data/english_house.db

# Birinchi CEO hisobini avtomatik yaratish uchun (ikkalasi ham ko'rsatilsa, birinchi
# ishga tushirishda yaratiladi; keyinroq admin panel orqali boshqa xodimlar qo'shiladi)
ADMIN_TEACHER_ID=CEO-1
ADMIN_PASSWORD=biror-kuchli-parol
ADMIN_FULL_NAME=Oydilla Odiljonov

# ---- Ixtiyoriy (Telegram bildirishnomalari uchun, kirish/login uchun EMAS) ----
BOT_TOKEN=your_bot_token_from_botfather
WEBHOOK_SECRET=biror-tasodifiy-uzun-soz-2026

# ---- Ixtiyoriy — Xizmat API kaliti (Cowork / tashqi avtomatlashtirish uchun) ----
# Sozlansa, quyidagi topshiriqlar endpoint'lariga login/parolsiz, "Authorization: Bearer <key>"
# header'i orqali ham kirish mumkin bo'ladi: /api/tasks, /api/tasks/all,
# /api/tasks/{id}/start, /api/tasks/{id}/done. Bo'sh qoldirilsa, bu usul o'chirilgan bo'ladi.
# Kuchli, tasodifiy qiymat: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_API_KEY=
